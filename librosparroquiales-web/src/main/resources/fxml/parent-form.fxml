<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="300.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fmm.librosparroquiales.javafx.controller.ParentFormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lblTituloFormulario" text="Datos del Progenitor" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        
        <HBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-width: 1;">
            <children>
                <Label text="Persona vinculada:" style="-fx-font-weight: bold;" />
                <Label fx:id="lblNombrePersonaCompleto" text="Nombre Apellido1 Apellido2" />
            </children>
        </HBox>
        
        <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="NIF / DNI:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNif" maxWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Lugar Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtBirthLocation" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" />
            </children>
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button text="Cancelar" onAction="#cancelar" />
                <Button text="Aceptar y Vincular" onAction="#guardar" style="-fx-base: #2ecc71; -fx-text-fill: white;" />
            </children>
        </HBox>
    </children>
</VBox>