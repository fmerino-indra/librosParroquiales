                           </children>
                        </VBox>
                     </children>
                  </GridPane>
 -->                  
               </children>
            </VBox>

            <VBox fx:id="panelPaso2" managed="false" spacing="15.0" visible="false">
               <children>
                  <Label text="Paso 2: Datos de los Padres" textFill="#2c3e50"><font><Font name="System Bold" size="16.0" /></font></Label>
                  <Separator />
                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" /><ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox><children><Label text="Nombre del Padre"/><TextField fx:id="txtPadreNombre" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Apellidos del Padre"/><TextField fx:id="txtPadreApellidos" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.rowIndex="1"><children><Label text="Nombre de la Madre"/><TextField fx:id="txtMadreNombre" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"><children><Label text="Apellidos de la Madre"/><TextField fx:id="txtMadreApellidos" prefHeight="30.0"/></children></VBox>
                     </children>
                     <rowConstraints><RowConstraints /><RowConstraints /></rowConstraints>
                  </GridPane>
                  <VBox prefWidth="200.0"><children><Label text="Filiación / Estado Matrimonial de los Padres"/><TextField fx:id="txtPadresFiliacion" prefHeight="30.0"/></children></VBox>
               </children>
            </VBox>

            <VBox fx:id="panelPaso3" managed="false" spacing="15.0" visible="false">
               <children>
                  <Label text="Paso 3: Padrinos y Abuelos" textFill="#2c3e50"><font><Font name="System Bold" size="16.0" /></font></Label>
                  <Separator />
                  <Label style="-fx-font-weight: bold;" text="Padrinos" textFill="#34495e" />
                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" /><ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox><children><Label text="Nombre y Apellidos del Padrino"/><TextField fx:id="txtPadrino" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Nombre y Apellidos de la Madrina"/><TextField fx:id="txtMadrina" prefHeight="30.0"/></children></VBox>
                     </children>
                     <rowConstraints><RowConstraints /></rowConstraints>
                  </GridPane>
                  <Separator />
                  <Label style="-fx-font-weight: bold;" text="Abuelos" textFill="#34495e" />
                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" /><ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox><children><Label text="Abuelo Paterno"/><TextField fx:id="txtAbueloPat" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Abuela Paterna"/><TextField fx:id="txtAbuelaPat" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.rowIndex="1"><children><Label text="Abuelo Materno"/><TextField fx:id="txtAbueloMat" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"><children><Label text="Abuela Materna"/><TextField fx:id="txtAbuelaMat" prefHeight="30.0"/></children></VBox>
                     </children>
                     <rowConstraints><RowConstraints /><RowConstraints /></rowConstraints>
                  </GridPane>
               </children>
            </VBox>

            <VBox fx:id="panelPaso4" managed="false" spacing="15.0" visible="false">
               <children>
                  <Label text="Paso 4: Datos de la Celebración y Registro" textFill="#2c3e50"><font><Font name="System Bold" size="16.0" /></font></Label>
                  <Separator />
                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" /><ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox><children><Label text="Fecha de Celebración *"/><DatePicker fx:id="dpFechaCeleb" maxWidth="1.7976931348623157E308" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Ministro Celebrante"/><TextField fx:id="txtMinistro" prefHeight="30.0"/></children></VBox>
                     </children>
                     <rowConstraints><RowConstraints /></rowConstraints>
                  </GridPane>
                  <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="34.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints />
                    </rowConstraints>
                     <children>
                        <VBox><children><Label text="Libro *"/><TextField fx:id="txtRegLibro" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Folio *"/><TextField fx:id="txtRegFolio" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="2"><children><Label text="Número Acta *"/><TextField fx:id="txtRegNumero" prefHeight="30.0"/></children></VBox>
                     </children>
                  </GridPane>
                  <VBox VBox.vgrow="ALWAYS"><children><Label text="Observaciones / Notas Marginales Iniciales"/><TextArea fx:id="txtObservaciones" prefHeight="100.0" wrapText="true" /></children></VBox>
               </children>
            </VBox>

         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>

      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#irAlPasoAnterior" prefHeight="35.0" prefWidth="100.0" style="-fx-cursor: hand;" text="Anterior" />
            <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#irAlPasoSiguiente" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Siguiente" />
         </children>
      </HBox>
      
   </children>
</VBox>