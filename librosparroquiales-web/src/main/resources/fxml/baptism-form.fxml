                <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#irAlPasoAnterior" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Anterior" />
                <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#irAlPasoSiguiente" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Siguiente" />
