<VBox spacing="20.0" 
  xmlns="http://javafx.com/javafx/21" 
  xmlns:fx="http://javafx.com/fxml/1" 
  fx:controller="org.fmm.librosparroquiales.javafx.controller.BaptismFormController">
   <children>
      
      <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
         <children>
            <Label fx:id="lblPaso1" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 10 5 10; -fx-background-radius: 15; -fx-font-weight: bold;" text="1. Candidato" />
            <Separator prefWidth="40.0" />
            <Label fx:id="lblPaso2" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-padding: 5 10 5 10; -fx-background-radius: 15; -fx-font-weight: bold;" text="2. Padres" />
            <Separator prefWidth="40.0" />
            <Label fx:id="lblPaso3" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-padding: 5 10 5 10; -fx-background-radius: 15; -fx-font-weight: bold;" text="3. Padrinos/Abuelos" />
            <Separator prefWidth="40.0" />
            <Label fx:id="lblPaso4" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-padding: 5 10 5 10; -fx-background-radius: 15; -fx-font-weight: bold;" text="4. Registro" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </HBox>

      <VBox style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
         <children>
            
            <VBox fx:id="panelPaso1" spacing="15.0">
               <children>
                  <Label text="Paso 1: Datos del Candidato al Bautismo" textFill="#2c3e50"><font><Font name="System Bold" size="16.0" /></font></Label>
                  <Separator />
                  <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="34.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="30.0" /><RowConstraints minHeight="30.0" />
                    </rowConstraints>
                     <children>
                        <VBox><children><Label text="Nombre *"/><TextField fx:id="txtCanNombre" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1"><children><Label text="Primer Apellido *"/><TextField fx:id="txtCanApellido1" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="2"><children><Label text="Segundo Apellido"/><TextField fx:id="txtCanApellido2" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.rowIndex="1"><children><Label text="Fecha Nacimiento *"/><DatePicker fx:id="dpCanFechaNac" maxWidth="1.7976931348623157E308" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"><children><Label text="Lugar de Nacimiento"/><TextField fx:id="txtCanLugarNac" prefHeight="30.0"/></children></VBox>
                        <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"><children><Label text="Sexo"/><ComboBox fx:id="cbCanSexo" maxWidth="1.7976931348623157E308" prefHeight="30.0"/></children></VBox>
                     </children>
                  </GridPane>
<!-- 
                  <VBox><children><Label text="Dirección Familiar"/><TextField fx:id="txtCanDireccion" prefHeight="30.0"/></children></VBox>
 -->
                  <Label style="-fx-font-weight: bold;" text="Dirección del Candidato" textFill="#34495e" />
                  <VBox spacing="15.0">
                     <children>
                        
                        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                           <children>
                              <VBox HBox.hgrow="ALWAYS" prefWidth="500.0">
                                 <children>
                                    <Label text="Calle / Avda / Pza *" />
                                    <TextField fx:id="txtDirCalle" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="160.0">
                                 <children>
                                    <Label text="Número *" />
                                    <TextField fx:id="txtDirNumero" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
                                 <children>
                                    <Label text="Piso" />
                                    <TextField fx:id="txtDirPiso" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
                                 <children>
                                    <Label text="Letra / Puerta" />
                                    <TextField fx:id="txtDirLetra" prefHeight="30.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                           <children>
                              <VBox HBox.hgrow="ALWAYS" prefWidth="160.0">
                                 <children>
                                    <Label text="Cód. Postal *" />
                                    <TextField fx:id="txtDirCodigoPostal" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="250.0">
                                 <children>
                                    <Label text="Población *" />
                                    <TextField fx:id="txtDirPoblacion" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="250.0">
                                 <children>
                                    <Label text="Provincia *" />
                                    <TextField fx:id="txtDirProvincia" prefHeight="30.0" />
                                 </children>
                              </VBox>
                              
                              <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
                                 <children>
                                    <Label text="País *" />
                                    <TextField fx:id="txtDirPais" prefHeight="30.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                     </children>
                  </VBox>              
