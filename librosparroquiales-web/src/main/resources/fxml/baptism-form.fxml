                           <children>
                              <Label text="Letra / Puerta" />
                              <TextField fx:id="txtDirLetra" prefHeight="30.0" />
                           </children>
                        </VBox>


                        <VBox GridPane.rowIndex="1" GridPane.columnIndex="0">
                           <children>
                              <Label text="Población *" />
                              <TextField fx:id="txtDirPoblacion" prefHeight="30.0" />
                           </children>
                        </VBox>
                        
                        <VBox GridPane.rowIndex="1" GridPane.columnIndex="1">
                           <children>
                              <Label text="Cód. Postal *" />
