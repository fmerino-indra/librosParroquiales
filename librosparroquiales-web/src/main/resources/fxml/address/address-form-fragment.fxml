<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>


<VBox spacing="15.0" 
    xmlns="http://javafx.com/javafx/" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:id="root"
    fx:controller="org.fmm.librosparroquiales.javafx.controller.address.AddressFragmentController">
    <children>
        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
            <Label fx:id="lblPanelTitle" text="hola" style="-fx-font-weight: bold;" />
            <children>
                <VBox HBox.hgrow="ALWAYS" prefWidth="500.0">
                    <children>
                        <Label text="Calle / Avda / Pza *" />
                        <TextField fx:id="txtAddCalle" prefHeight="30.0" />
                    </children>
                </VBox>
	            <VBox HBox.hgrow="ALWAYS" prefWidth="160.0">
	               <children>
	                  <Label text="Número *" />
	                  <TextField fx:id="txtAddNumero" prefHeight="30.0" />
	               </children>
	            </VBox>
	            <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
	               <children>
	                  <Label text="Piso" />
	                  <TextField fx:id="txtAddPiso" prefHeight="30.0" />
	               </children>
	            </VBox>
	            
	            <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
	               <children>
	                  <Label text="Letra / Puerta" />
	                  <TextField fx:id="txtAddLetra" prefHeight="30.0" />
	               </children>
	            </VBox>
            </children>
        </HBox>

      <HBox spacing="15.0" alignment="BOTTOM_LEFT">
         <children>
            <VBox HBox.hgrow="ALWAYS" prefWidth="160.0">
               <children>
                  <Label text="Cód. Postal *" />
                  <TextField fx:id="txtAddCodigoPostal" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox HBox.hgrow="ALWAYS" prefWidth="250.0">
               <children>
                  <Label text="Población *" />
                  <TextField fx:id="txtAddPoblacion" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox HBox.hgrow="ALWAYS" prefWidth="250.0">
               <children>
                  <Label text="Provincia *" />
                  <TextField fx:id="txtAddProvincia" prefHeight="30.0" />
               </children>
            </VBox>
            
            <VBox HBox.hgrow="ALWAYS" prefWidth="170.0">
               <children>
                  <Label text="País *" />
                  <TextField fx:id="txtAddPais" prefHeight="30.0" />
               </children>
            </VBox>
         </children>
      </HBox>

   </children>
</VBox>              
