<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>


<VBox spacing="15.0" 
    xmlns="http://javafx.com/javafx/" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:id="root"
    fx:controller="org.fmm.librosparroquiales.javafx.controller.address.AddressShortFragmentController">
    <children>
        <Label fx:id="lblPanelTitle" text="hola" style="-fx-font-weight: bold;" />
        <HBox spacing="5.0" alignment="BOTTOM_LEFT">
            <children>
                <TextField fx:id="txtAddressId" prefHeight="30.0" prefWidth="65.0"/>
	            <TextField fx:id="txtShortAddress1" prefHeight="30.0"  prefWidth="500.0"/>
                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#searchAddressModal" prefHeight="30.0" style="-fx-cursor: hand;">
                    <graphic>
                        <javafx.scene.shape.SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#555555" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>                           
                <Button fx:id="btnClean" disable="true" mnemonicParsing="false" 
                    onAction="#cleanAddress" text="&#x274C;" prefHeight="30.0" style="-fx-cursor: hand; -fx-text-fill: red;"/>
            </children>
        </HBox>
        <HBox spacing="15.0" alignment="BOTTOM_LEFT">
            <children>
                <VBox HBox.hgrow="ALWAYS" prefWidth="160.0">
                    <children>
                        <TextField fx:id="txtShortAddress2" prefHeight="30.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>              
