<GridPane hgap="15.0" vgap="15.0" 
  xmlns="http://javafx.com/javafx/21" 
  xmlns:fx="http://javafx.com/fxml/1" 
  fx:controller="org.fmm.librosparroquiales.javafx.controller.person.PersonFormFragmentController">
  <columnConstraints>
    <ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="33.0" /><ColumnConstraints percentWidth="34.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="30.0" /><RowConstraints minHeight="30.0" />
  </rowConstraints>
   <children>
      <VBox><children><Label text="Nombre *"/><TextField fx:id="txtName" prefHeight="30.0"/></children></VBox>
      <VBox GridPane.columnIndex="1"><children><Label text="Primer Apellido *"/><TextField fx:id="txtSurname1" prefHeight="30.0"/></children></VBox>
      <VBox GridPane.columnIndex="2"><children><Label text="Segundo Apellido"/><TextField fx:id="txtSurname2" prefHeight="30.0"/></children></VBox>
      <VBox GridPane.rowIndex="1"><children><Label text="Fecha Nacimiento *"/><DatePicker fx:id="dpBirthdate" maxWidth="1.7976931348623157E308" prefHeight="30.0"/></children></VBox>
      <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"><fx:include fx:id="genderFragment" source="/fxml/gender/gender-fragment.fxml" /></VBox>
   </children>
</GridPane>
